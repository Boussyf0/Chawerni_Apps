# Copier en .env et renseigner (NE PAS committer .env).
# --- LLM (Groq) ---
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b          # réponses (qualité ; remplace llama-3.3-70b, décommissionné 16/08/2026)
GROQ_MODEL_FAST=openai/gpt-oss-20b      # reformulation darija→fusha (remplace llama-3.1-8b, décommissionné 16/08/2026)
# --- Index vectoriel (Qdrant Cloud free tier) ---
QDRANT_URL=https://xxxxxxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=xxx
# --- Domaine (Caddy TLS) ---
DOMAIN=chawerni.me
